# CONTROL PLANE (hosted API). It never trades and holds no keys, wallet sessions or AI keys.
APP_ENV=development
SECRET_KEY=change-me-min-32-chars-random
JWT_SECRET=change-me-min-32-chars-random
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agent
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
ACCESS_TOKEN_MINUTES=60
REGISTRATION_ENABLED=true
TRUST_PROXY=false            # true behind Render/Vercel proxies so rate limits see the real client IP

# Arc network (documented defaults; ARC_NETWORK=mainnet|testnet derives the rest; overrides must match the network)
ARC_NETWORK=mainnet
ARC_RPC_URL=
ARC_RPC_FALLBACK_URLS=
ARC_WS_URL=
ARC_CHAIN_ID=
ARC_EXPLORER_URL=
ARC_USDC_ADDRESS=

# Global kill switch for LIVE activation from the UI. Even when true, LIVE also needs a Local Runner that reports it is ready.
LIVE_TRADING_ENABLED=false
PAPER_TRADING_ENABLED=true
PAPER_STARTING_USDC=1000

RISK_MAX_TRADE_USDC=25
RISK_MAX_POSITION_USDC=50
RISK_MAX_DAILY_LOSS_USDC=50
RISK_MAX_TOTAL_EXPOSURE_USDC=250
RISK_MAX_OPEN_POSITIONS=5
RISK_MAX_SLIPPAGE_PCT=2
RISK_MIN_LIQUIDITY_USDC=10000

# ---- Cloud managed (shared worker + per-user Privy) ----
CLOUD_MANAGED_ENABLED=false
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_API_URL=https://api.privy.io/v1
# Long random secret shared with the cloud worker process
PLATFORM_WORKER_TOKEN=

# Platform hard ceilings (users cannot exceed)
PLATFORM_MAX_TRADE_USDC=100
PLATFORM_MAX_POSITION_USDC=250
PLATFORM_MAX_DAILY_LOSS_USDC=250
PLATFORM_MAX_TOTAL_EXPOSURE_USDC=1000
PLATFORM_MAX_OPEN_POSITIONS=20
PLATFORM_MAX_SLIPPAGE_PCT=5
PLATFORM_MIN_LIQUIDITY_USDC=5000
