# Local Runner configuration. Copy to `.env` next to the runner (or export these as real environment
# variables) — never commit a filled-in copy. All keys accept either the bare name (e.g. DATA_SOURCE) or the
# ARC_RUNNER_-prefixed form (e.g. ARC_RUNNER_DATA_SOURCE); the prefixed form always wins if both are set.

# ------------------------------------------------------------------ core
ARC_RUNNER_SERVER_URL=http://localhost:8000
ARC_RUNNER_STATE_DIR=~/.arc-runner
ARC_RUNNER_NAME=runner
ARC_RUNNER_DATA_SOURCE=arc                      # arc | demo

# HARD local ceilings. A compromised control plane can never push the runner past these.
ARC_RUNNER_CEILING_MAX_TRADE_USDC=25
ARC_RUNNER_CEILING_MAX_POSITION_USDC=50
ARC_RUNNER_CEILING_MAX_DAILY_LOSS_USDC=50
ARC_RUNNER_CEILING_MAX_TOTAL_EXPOSURE_USDC=250
ARC_RUNNER_CEILING_MAX_OPEN_POSITIONS=5
ARC_RUNNER_CEILING_MAX_SLIPPAGE_PCT=2
ARC_RUNNER_CEILING_MIN_LIQUIDITY_USDC=10000
ARC_RUNNER_CEILING_ALLOWED_CHAINS=arc

ARC_RUNNER_LIVE_ENABLED=false
ARC_RUNNER_WALLET_PROVIDER=none                 # none | circle_agent_wallet | privy
ARC_RUNNER_CIRCLE_CLI_PATH=circle
ARC_RUNNER_CIRCLE_CHAIN=ARC
ARC_RUNNER_CIRCLE_WALLET_ADDRESS=

# ------------------------------------------------------------------ Arc network
ARC_RUNNER_ARC_NETWORK=mainnet                  # mainnet | testnet
ARC_RUNNER_ARC_RPC_URL=                         # empty = network default (or Goldsky, see below)
ARC_RUNNER_ARC_RPC_FALLBACK_URLS=               # comma separated

# ------------------------------------------------------------------ market-data providers
# Order is provider *preference*. Defaults favor free providers with real Arc coverage.
ARC_RUNNER_MARKET_DATA_PROVIDERS=dexpaprika,goldsky,geckoterminal,dexscreener
ARC_RUNNER_MARKET_DATA_ESSENTIAL_PROVIDERS=dexpaprika
ARC_RUNNER_MARKET_DATA_MAX_TOKENS=20
ARC_RUNNER_MARKET_DATA_CACHE_S=120
ARC_RUNNER_MARKET_DATA_TIMEOUT_S=6
ARC_RUNNER_MARKET_DATA_FAILURE_THRESHOLD=3
ARC_RUNNER_MARKET_DATA_COOLDOWN_S=60
ARC_RUNNER_MARKET_DATA_CACHE_TTL_S=15

ARC_RUNNER_DEXPAPRIKA_BASE_URL=https://api.dexpaprika.com
ARC_RUNNER_DEXPAPRIKA_NETWORK=arc
ARC_RUNNER_DEXPAPRIKA_API_KEY=                  # optional: raises the free rate limit from 15/min to 30/min
ARC_RUNNER_DEXPAPRIKA_MIN_TXNS_24H=1
ARC_RUNNER_DEXPAPRIKA_MIN_VOLUME_24H_USD=100
ARC_RUNNER_DEXPAPRIKA_LOOKBACK_HOURS=24

ARC_RUNNER_GOLDSKY_API_KEY=
ARC_RUNNER_GOLDSKY_ARC_RPC_URL=https://edge.goldsky.com/standard/evm/5042
ARC_RUNNER_PREFER_GOLDSKY_RPC=true              # set ARC_RUNNER_ARC_RPC_URL= (empty) to fall back to this

ARC_RUNNER_GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2
ARC_RUNNER_GECKOTERMINAL_NETWORK=arc
ARC_RUNNER_GECKOTERMINAL_API_KEY=

ARC_RUNNER_DEXSCREENER_CHAIN_ID=arc
ARC_RUNNER_DEXSCREENER_CACHE_S=60

# ------------------------------------------------------------------ discovery / scanning mode
ARC_RUNNER_SCAN_NEW_LAUNCHES=true
ARC_RUNNER_SCAN_ESTABLISHED=true
ARC_RUNNER_ESTABLISHED_MIN_AGE_HOURS=24
ARC_RUNNER_ESTABLISHED_MIN_HOLDERS=70
ARC_RUNNER_ESTABLISHED_MIN_MARKET_CAP_USDC=50000
ARC_RUNNER_GLOBAL_CANDIDATE_SCORE_THRESHOLD=40

# ------------------------------------------------------------------ enrichment (contract / holders / creator / MEV)
# Fills the gaps a bare market-data provider leaves: contract verification, sellability, top-holder
# concentration, holder growth, creator identity, launchpad detection, and a MEV-exposure heuristic.
# See backend/app/enrichment/. All of this is optional -- with nothing configured below, enrichment still
# runs using Blockscout's free public (keyless) route plus on-chain RPC probes; it degrades further, never
# fabricates, when even those are unavailable.
ARC_RUNNER_ENRICHMENT_ENABLED=true

# Blockscout is Arc's official explorer. A Pro API key is optional; without one, the keyless public route is
# used (lower rate limit, no credit budget to manage). Get a Pro key at https://www.blockscout.com/apis-plans.
ARC_RUNNER_BLOCKSCOUT_ENABLED=true
ARC_RUNNER_BLOCKSCOUT_API_KEY=
ARC_RUNNER_BLOCKSCOUT_PRO_ROOT=https://api.blockscout.com
ARC_RUNNER_BLOCKSCOUT_PUBLIC_ROOT=https://explorer.arc.io
ARC_RUNNER_BLOCKSCOUT_DAILY_CREDIT_BUDGET=90000   # stays under the 100K/day free-tier ceiling

# Etherscan V2 (chainid=5042) is the secondary source. Get a free key at https://etherscan.io/apis.
# Per Etherscan's Arc listing, community access is free until 2026-10-15 and needs a paid plan after; the
# client detects a plan-gated response and stops asking for that specific call rather than retrying forever.
ARC_RUNNER_ETHERSCAN_ENABLED=true
ARC_RUNNER_ETHERSCAN_API_KEY=

ARC_RUNNER_ENRICHMENT_HOLDERS_TTL_S=300          # top-N holder % / holder count cache
ARC_RUNNER_ENRICHMENT_STATIC_TTL_S=21600         # verification / creator / launchpad cache (6h)
ARC_RUNNER_ENRICHMENT_PROBE_TTL_S=900            # on-chain admin-power probe cache

# ------------------------------------------------------------------ paid providers (optional)
ARC_RUNNER_BITQUERY_API_KEY=
ARC_RUNNER_BITQUERY_ENDPOINT=https://streaming.bitquery.io/graphql
ARC_RUNNER_UNISWAP_API_KEY=
ARC_RUNNER_UNISWAP_API_URL=https://trade-api.gateway.uniswap.org/v1

# ------------------------------------------------------------------ live trading gates
ARC_RUNNER_CIRCLE_ALLOW_CONTRACT_EXECUTE=false
ARC_RUNNER_CIRCLE_REQUIRE_SPENDING_POLICY=true
ARC_RUNNER_LIVE_TRADING_VERIFIED=false

ARC_RUNNER_PRIVY_APP_ID=
ARC_RUNNER_PRIVY_APP_SECRET=
ARC_RUNNER_PRIVY_WALLET_ID=
ARC_RUNNER_PRIVY_WALLET_ADDRESS=
ARC_RUNNER_PRIVY_API_URL=https://api.privy.io/v1
ARC_RUNNER_PRIVY_CAIP2=eip155:5042
ARC_RUNNER_PRIVY_ALLOW_EXECUTE=false
ARC_RUNNER_PRIVY_ALLOW_WITHDRAW=false

# ------------------------------------------------------------------ AI (optional)
ARC_RUNNER_LLM_PROVIDER=none                    # none | openrouter | anthropic | openai
ARC_RUNNER_AI_MODEL=
ARC_RUNNER_OPENROUTER_API_KEY=
ARC_RUNNER_ANTHROPIC_API_KEY=
ARC_RUNNER_OPENAI_API_KEY=
ARC_RUNNER_OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------ optional: worker-side persistence
ARC_RUNNER_REDIS_URL=redis://localhost:6379/0
ARC_RUNNER_DATABASE_URL=
