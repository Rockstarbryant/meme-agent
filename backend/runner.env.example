# LOCAL RUNNER (runs on YOUR machine). Everything here stays on your machine.
ARC_RUNNER_SERVER_URL=http://localhost:8000
ARC_RUNNER_STATE_DIR=~/.arc-runner          # credentials.json (runner token), approval.key, state.db: all mode 600
ARC_RUNNER_NAME=my-laptop

# Data: "demo" = synthetic, clearly labelled, PAPER only. "arc" = real Arc data (no verified source yet: reports unavailable).
ARC_RUNNER_DATA_SOURCE=arc
ARC_RUNNER_ARC_NETWORK=mainnet
ARC_RUNNER_ARC_RPC_URL=
ARC_RUNNER_BITQUERY_API_KEY=
ARC_RUNNER_BITQUERY_ENDPOINT=https://streaming.bitquery.io/graphql
ARC_RUNNER_UNISWAP_API_KEY=
ARC_RUNNER_UNISWAP_API_URL=https://trade-api.gateway.uniswap.org/v1

# LOCAL HARD CEILINGS. The control plane can never push the runner past these.
ARC_RUNNER_CEILING_MAX_TRADE_USDC=25
ARC_RUNNER_CEILING_MAX_POSITION_USDC=50
ARC_RUNNER_CEILING_MAX_DAILY_LOSS_USDC=50
ARC_RUNNER_CEILING_MAX_TOTAL_EXPOSURE_USDC=250
ARC_RUNNER_CEILING_MAX_OPEN_POSITIONS=5
ARC_RUNNER_CEILING_MAX_SLIPPAGE_PCT=2
ARC_RUNNER_CEILING_MIN_LIQUIDITY_USDC=10000
ARC_RUNNER_CEILING_ALLOWED_CHAINS=arc

# Dead-man switch: no control-plane contact for this long => no NEW entries (exits keep running)
ARC_RUNNER_MAX_OFFLINE_S=60

# LIVE needs BOTH this AND your activation in the web app AND a verified wallet provider. Default: off.
ARC_RUNNER_LIVE_ENABLED=false
ARC_RUNNER_WALLET_PROVIDER=none              # none | circle_agent_wallet | privy
ARC_RUNNER_CIRCLE_CLI_PATH=circle
ARC_RUNNER_CIRCLE_CHAIN=ARC                  # confirm with `circle blockchain list`
ARC_RUNNER_CIRCLE_WALLET_ADDRESS=
# Explicit local safety acknowledgement for unattended Circle wallet.execute. Default false.
ARC_RUNNER_CIRCLE_ALLOW_CONTRACT_EXECUTE=false
ARC_RUNNER_CIRCLE_REQUIRE_SPENDING_POLICY=true
# Set true ONLY after you have run `python -m runner circle-verify`, reviewed the capture JSON,
# confirmed Permit2 / wallet execute / fill behaviour on testnet, and accept the risk.
# Default false keeps LIVE fail-closed.
ARC_RUNNER_LIVE_TRADING_VERIFIED=false

# AI provider: configured ONLY here (the server never sees these keys). Optional in PAPER.
LLM_PROVIDER=none                            # none | openrouter | anthropic | openai
AI_MODEL=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Privy server wallets (cloud LIVE, no local CLI) ----
# Create an app at https://dashboard.privy.io → App settings → API keys
# Create a server wallet (chain_type=ethereum), fund it with USDC on Arc, note wallet id + address
ARC_RUNNER_WALLET_PROVIDER=privy
ARC_RUNNER_PRIVY_APP_ID=
ARC_RUNNER_PRIVY_APP_SECRET=
ARC_RUNNER_PRIVY_WALLET_ID=
ARC_RUNNER_PRIVY_WALLET_ADDRESS=
ARC_RUNNER_PRIVY_API_URL=https://api.privy.io/v1
ARC_RUNNER_PRIVY_CAIP2=eip155:5042
# Explicit safety switch — keep false until funded + policies reviewed
ARC_RUNNER_PRIVY_ALLOW_EXECUTE=false
# Still required for LIVE with Privy (marks fill/quote path accepted for this runner)
ARC_RUNNER_LIVE_ENABLED=false
ARC_RUNNER_LIVE_TRADING_VERIFIED=false

# ---- Shared cloud worker (multi-tenant) ----
# Same token as control plane PLATFORM_WORKER_TOKEN
PLATFORM_WORKER_TOKEN=
# python -m runner cloud-worker
